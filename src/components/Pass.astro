---
// The access pass: a fixed layer at the viewport's top right. The strap hangs from the top edge; the
// physics card (src/three/Badge.tsx, lazy) drops in shortly after load and stays draggable on every
// scroll position. The static SVG is the reduced-motion / no-WebGL version (same place, same size).
// Decorative only (bug 5 / accessibility): the whole thing is aria-hidden and never focusable.
import { site } from '../data/site';
import { LOGO_BOX, LOGO_PATH, LOGO_TRANSFORM, LOGO_VIEWBOX } from '../data/logo';
const { badge } = site;
const logoH = 13;
const holder = badge.holder.toUpperCase().split(' ');
---
<aside class="pass" aria-hidden="true" data-pass>
  <svg class="pass__static" viewBox="80 0 240 500" aria-hidden="true" focusable="false">
    <path d="M200 0 V168" stroke="#0a0a0a" stroke-width="22" />
    <g class="pass__static-card">
      <rect x="182" y="150" width="36" height="34" rx="3" fill="#b0b0b0" />
      <rect x="88" y="176" width="224" height="315" rx="11" fill="#0d0d0d" />
      <rect x="99" y="187" width="202" height="293" rx="2" fill="none" stroke="#fff" stroke-opacity=".16" />
      <rect x="180" y="195" width="40" height="8" rx="4" fill="#262626" stroke="#fff" stroke-opacity=".22" />
      <svg x="108" y="216" width={(logoH * LOGO_BOX.w) / LOGO_BOX.h} height={logoH} viewBox={LOGO_VIEWBOX} fill="#fff"><g transform={LOGO_TRANSFORM}><path d={LOGO_PATH} /></g></svg>
      <text x="292" y="229" text-anchor="end" class="pass__svg-k">{badge.kicker.toUpperCase()}</text>
      <line x1="108" y1="250" x2="292" y2="250" stroke="#fff" stroke-opacity=".16" />
      {holder.map((w, i) => <text x="106" y={300 + i * 32} class="pass__svg-holder" data-pass-holder={i === 0 ? '' : undefined}>{i === 0 ? w : ''}</text>)}
      <text x="108" y={300 + holder.length * 32 + 2} class="pass__svg-k">{badge.role.toUpperCase()} · {badge.event.toUpperCase()}</text>
      <line x1="108" y1="402" x2="292" y2="402" stroke="#fff" stroke-opacity=".16" />
      <text x="108" y="418" class="pass__svg-k">ID</text>
      <text x="292" y="418" text-anchor="end" class="pass__svg-v" data-pass-id>{badge.id}</text>
      <g fill="#fff">{Array.from({ length: 34 }, (_, i) => <rect x={108 + i * 5.4} y="440" width={i % 3 === 0 ? 2.6 : 1.2} height="24" />)}</g>
    </g>
  </svg>
  <div class="pass__canvas" data-pass-canvas aria-hidden="true"></div>
  <div class="pass__hit" data-pass-hit data-cursor="Drag" aria-hidden="true"></div>
  <p class="pass__hint t-kicker" aria-hidden="true"><span class="pass__dot"></span>{badge.note}</p>
</aside>
