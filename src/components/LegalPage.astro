---
// Shared layout for /privacy, /terms, /security and /cookies: a plain, readable article —
// no scroll story, no hero, everything in the first viewport. See PLAN-v3.md "Legal".
interface Props {
  title: string;
  versionDate?: string;
  intro?: string;
  pending?: boolean;
}
const { title, versionDate, intro, pending = true } = Astro.props;
---

<article class="legal band sec">
  <div class="wrap legal__wrap">
    <header class="legal__head">
      <p class="t-kicker muted">Legal</p>
      <h1 class="t-h2">{title}</h1>
      {intro && <p class="t-lead muted legal__intro">{intro}</p>}
      {versionDate && (
        <p class="t-meta muted legal__meta">
          Version {versionDate}
          {pending && <> · Reviewed by counsel: pending</>}
        </p>
      )}
    </header>
    <div class="legal__body t-body">
      <slot />
    </div>
  </div>
</article>

<style>
  .legal__wrap { max-width: 760px; }
  .legal__head { margin-bottom: clamp(32px, 4vw, 56px); display: grid; gap: var(--sp-3); }
  .legal__intro { margin-top: var(--sp-2); max-width: 46ch; }
  .legal__meta { margin-top: var(--sp-2); }
  .legal__body { display: grid; gap: var(--sp-4); }
  .legal__body :global(h2) {
    font: 600 var(--t-h3)/1.2 var(--f-display); letter-spacing: -0.02em;
    margin-top: var(--sp-10);
  }
  .legal__body :global(h2:first-of-type) { margin-top: var(--sp-4); }
  .legal__body :global(p) { color: var(--fg); }
  .legal__body :global(ul) { display: grid; gap: var(--sp-2); padding-left: 1.3em; list-style: disc; }
  .legal__body :global(li) { color: var(--fg); }
  .legal__body :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .legal__body :global(strong) { font-weight: 600; }
  .legal__body :global(table) { width: 100%; border-collapse: collapse; margin-top: var(--sp-2); }
  .legal__body :global(th), .legal__body :global(td) {
    text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--line); font-size: var(--t-meta);
  }
  .legal__body :global(th) { color: var(--muted); font-weight: 500; }
</style>
