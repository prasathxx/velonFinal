---
import { site } from '../data/site';
import Label from './Label.astro';
import Button from './Button.astro';
import Pill from './Pill.astro';
const { hero } = site;
// depth planes per statement line (flight.ts): the drone parks behind line 2 and in front of 1 + 3
const planes = [-0.5, 0.6, -0.5];
---
<section id="top" class="hero band fx-bg" aria-labelledby="hero-title" data-flight="hero" data-flight-label="Hero">
  <div class="backdrop backdrop--hero" aria-hidden="true"></div>
  <img class="hero__poster" src="/poster/hero-drone.webp" alt="" width="900" height="640" loading="lazy" decoding="async" fetchpriority="low" aria-hidden="true" />
  <div class="hero__in wrap">
    <div class="hero__top">
      <Label num="01" text={hero.eyebrow} class="hero__eyebrow" data-hero-fade />
      <p class="t-label muted hero__aside" data-hero-fade>{hero.aside}</p>
    </div>

    <div class="hero__head">
      <h1 id="hero-title" class="t-statement hero__title" data-hero-title>
        {hero.headlineLines.map((l, i) => (
          <>{i > 0 && ' '}<span class={`ln ln--${i + 1}${(planes[i] ?? 0) > 0 ? ' is-fore' : ''}`} data-depth={planes[i] ?? -0.5}>{l}</span></>
        ))}
      </h1>
      <p class="hero__sub" data-hero-fade>{hero.subline}</p>
    </div>

    <div class="hero__bottom grid">
      <div class="hero__copy">
        <p class="t-lead hero__lead" data-hero-lead>{hero.lead}</p>
        <div class="hero__ctas" data-hero-fade>
          <Button href={hero.primaryCta.href} label={hero.primaryCta.label} magnetic data-cursor-off />
          <Button href={hero.secondaryCta.href} label={hero.secondaryCta.label} variant="ghost" data-cursor-off />
        </div>
      </div>
      <div class="hero__meta" data-hero-fade>
        <Pill facts={hero.facts} />
        <a href="#solutions" class="hero__scroll t-kicker" aria-label="Scroll to products">
          <span>Scroll</span><span class="hero__scroll-line" aria-hidden="true"><i></i></span>
        </a>
      </div>
    </div>
  </div>
</section>
